# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is git-ignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# App
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Database (local docker-compose uses these defaults)
DATABASE_URL=postgresql://kb_admin:kb_local_password@localhost:5432/knowledge_base

# Auth — set any string here for local dev; replace with Cognito in production
JWT_SECRET=local-dev-secret-change-me
JWT_EXPIRE_MINUTES=60

# AI — add at least one to enable the assistant panel
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AWS — only needed in production (leave blank for local dev)
AWS_REGION=us-east-1
SECRET_NAME=

# S3 — only needed if you want file upload to S3 (local dev stores base64 inline)
S3_BUCKET=
