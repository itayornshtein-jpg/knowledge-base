# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ── Environment / Secrets ─────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is safe to commit — it has no real values

# ── Node / React ──────────────────────────────────────────────
node_modules/
/.pnp
.pnp.js
/coverage
/build         # React production build (generated by CI)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Database ──────────────────────────────────────────────────
db.json        # old flat-file database — don't commit new data here
*.sqlite
*.db

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Docker ────────────────────────────────────────────────────
.dockerignore  # not ignored, just noting it exists

# ── Alembic ───────────────────────────────────────────────────
# alembic/versions/*.py  — keep migration files in git, don't ignore them
